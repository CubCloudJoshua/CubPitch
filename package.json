{
  "name": "cubpitch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "tsc -b tsconfig.build.json --clean",
    "cli": "pnpm --filter @cubpitch/cli start",
    "web": "pnpm --filter @cubpitch/web dev"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
